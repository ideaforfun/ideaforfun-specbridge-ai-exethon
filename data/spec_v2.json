{
  "name": "가상 금융 마이데이터 표준 API",
  "version": "V2",
  "apis": [
    {"id": "GET_ACCOUNTS", "method": "GET", "path": "/accounts",
      "request": [
        {"name": "org_code", "type": "string", "required": true, "description": "기관 식별 코드"},
        {"name": "access_token", "type": "string", "required": true, "description": "접근 토큰"},
        {"name": "purpose_code", "type": "string", "required": true, "description": "요청 목적 코드"}
      ],
      "response": [
        {"name": "account_id", "type": "string", "required": true, "description": "계좌 ID"},
        {"name": "balance", "type": "number", "required": true, "description": "잔액 숫자"},
        {"name": "account_status", "type": "string", "required": false, "description": "계좌 상태"}
      ],
      "errors": [
        {"name": "E401", "type": "string", "required": false, "description": "인증 실패"},
        {"name": "E429", "type": "string", "required": false, "description": "재시도 제한"}
      ]}
  ]
}
